   <configurations>
      <!-- OSGi Service Loader Mediator, must be active before ServiceLoader consumers are loaded.
           Not at start level 1: bundles of that level are installed by the framework (osgi.bundles
           in config.ini) before the simple configurator installs ASM, which SPI Fly requires.
           ServiceLoader consumers started early (logback via SLF4J, POI) start at level 3. -->
      <plugin id="org.apache.aries.spifly.dynamic.bundle" autoStart="true" startLevel="2" />
      <plugin id="de.fhg.igd.slf4jplus.logback" autoStart="true" startLevel="3" />
      <plugin id="eu.esdihumboldt.cst" autoStart="true" startLevel="0" />
