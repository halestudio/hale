<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<!--
  Base of the target platform of hale»studio. The platform build (build/platform) generates
  local-platform.target from this file, adding a location with the libraries generated from the
  hale-core BOM. The wetransform repositories are only available via http.
-->
<target name="eu.esdihumboldt.hale.platform" sequenceNumber="1">
<locations>
<!-- Eclipse platform, EMF, Equinox and ECF (Eclipse 2020-03) -->
<location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="org.eclipse.emf.sdk.feature.group" version="2.21.0.v20200205-0529"/>
<unit id="org.eclipse.equinox.sdk.feature.group" version="3.20.100.v20200303-1901"/>
<unit id="org.eclipse.ecf.core.feature.feature.group" version="1.5.500.v20200217-1548"/>
<unit id="org.eclipse.ecf.core.ssl.feature.feature.group" version="1.1.300.v20191023-2007"/>
<unit id="org.eclipse.ecf.filetransfer.feature.feature.group" version="3.14.700.v20200217-0016"/>
<unit id="org.eclipse.ecf.filetransfer.httpclient45.feature.feature.group" version="1.0.300.v20200217-0016"/>
<unit id="org.eclipse.ecf.filetransfer.ssl.feature.feature.group" version="1.1.200.v20191024-1546"/>
<repository location="http://build-artifacts.wetransform.to/p2/mirror/2020-03-releases/"/>
</location>
<location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="org.eclipse.e4.core.tools.feature.source.feature.group" version="4.15.0.v20200217-1230"/>
<unit id="org.eclipse.sdk.ide" version="4.15.0.I20200305-0155"/>
<repository location="http://build-artifacts.wetransform.to/p2/mirror/2020-03-eclipse/"/>
</location>
<!-- help system (Jetty 8) -->
<location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="org.eclipse.jetty.bundles.f.feature.group" version="8.1.18.201510140934"/>
<repository location="http://build-artifacts.wetransform.to/p2/mirror/jetty-8"/>
</location>
<!-- Draw2D (GEF legacy), required by Zest -->
<location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="org.eclipse.gef.all.feature.group" version="3.11.0.201606061308"/>
<repository location="http://build-artifacts.wetransform.to/p2/mirror/gef-legacy-releases/"/>
</location>
<!-- Zest 2 (2012 snapshot), taken from the former platform site until it is replaced by GEF Classic -->
<location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="org.eclipse.zest.core" version="2.0.0.201204272302-i20231028"/>
<unit id="org.eclipse.zest.jface" version="2.0.0.201204272302"/>
<unit id="org.eclipse.zest.layouts" version="2.0.0.201204272302"/>
<unit id="org.eclipse.zest.dot.export" version="2.0.0.201204272302"/>
<repository location="https://gitlab.wetransform.to/hale/hale-build-support/raw/0342a0f0c4f57a1ec4109f1fbe6e6fecd7dc722b/updatesites/platform"/>
</location>
<!-- Eclipse utilities of Fraunhofer IGD (de.fhg.igd.eclipse.util, also used by hale-core) -->
<location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="de.fhg.igd.eclipse.ui.util.feature.feature.group" version="1.0.0.201407081822"/>
<unit id="de.fhg.igd.eclipse.util.feature.feature.group" version="1.0.0.201407081822"/>
<repository location="http://build-artifacts.wetransform.to/p2/eclipse-util/import"/>
</location>
<!-- slf4jplus UI (ui.userstatus, ui.errorlog); the slf4jplus core bundles come from hale-core -->
<location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="de.fhg.igd.slf4jplus.ui.feature.feature.group" version="1.2.0.201503311443"/>
<!-- required by ui.userstatus, not provided by hale-core -->
<unit id="de.fhg.igd.slf4jplus.logback.observer" version="1.2.0.201503311443"/>
<repository location="http://build-artifacts.wetransform.to/p2/slf4jplus/import"/>
</location>
<!-- test runner of the test product -->
<location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="de.fhg.igd.equinox.test.feature.feature.group" version="1.2.0.202403131049"/>
<repository location="http://build-artifacts.wetransform.to/p2/equinox-test/96b3ede3cee11a98a1290edc330e421bb6ae2c86"/>
</location>
</locations>
</target>
