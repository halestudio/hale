<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  
  <groupId>${groupId}</groupId>
  <artifactId>${artifactId}</artifactId>
  <version>${version}</version>
  <packaging>${packaging}</packaging>
  
  <parent>
    <groupId>${parentGroupId}</groupId>
    <artifactId>${parentArtifactId}</artifactId>
    <version>${parentVersion}</version>
    <relativePath>${parentRelativePath}</relativePath>
  </parent>
  
  <properties>
	<doc.output.folder>\${project.build.directory}/gen-doc/</doc.output.folder>
  </properties>
  
  <build>
    <plugins>
      <% if (extraRequirements) { %>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>\${tycho-version}</version>
        <configuration>
	  <dependency-resolution>
	    <extraRequirements>
          <% extraRequirements.each { %>
	      <requirement>
	        <type>eclipse-plugin</type>
  	        <id>$it</id>
	        <versionRange>0.0.0</versionRange>
	      </requirement>
	      <% } %>
	    </extraRequirements>
	  </dependency-resolution>
        </configuration>
      </plugin>
      <% } %>
      <% if (isJavaProject && !needsGroovy && !needsScala) { %>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-compiler-plugin</artifactId>
        <version>\${tycho-version}</version>
        <configuration>
          <source>$javaSource</source>
          <target>$javaTarget</target>
          <excludeResources>
       		<!-- Exclude translation files (because they are very incomplete ATM) -->
       		<excludeResource>**/messages_*.properties</excludeResource>
       		<excludeResource>**/bundle_*.properties</excludeResource>
     	  </excludeResources>
        </configuration>
      </plugin>
      <% } %>
      <% if (needsScala) { %>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-compiler-plugin</artifactId>
        <version>\${tycho-version}</version>
        <configuration>
          <source>$javaSource</source>
          <target>$javaTarget</target>
          <!-- exclude scala source files; they will be compiled
               by the maven-scala-plugin (see below) and must not
               be included into the output jar -->
          <excludeResources>
            <excludeResource>**/*.scala</excludeResource>
            <!-- Exclude translation files (because they are very incomplete ATM) -->
            <excludeResource>**/messages_*.properties</excludeResource>
            <excludeResource>**/bundle_*.properties</excludeResource>
          </excludeResources>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.scala-tools</groupId>
        <artifactId>maven-scala-plugin</artifactId>
        <version>\${scala.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <jvmArgs>
            <jvmArg>-Xms25G</jvmArg>
            <jvmArg>-Xmx25G</jvmArg>
          </jvmArgs>
          <scalaVersion>\${scala.version}</scalaVersion>
        </configuration>
      </plugin>
      <% } %>
      <% if (needsGroovy) { %>
      <!-- Always compile the Groovy bundles completely: groovy-eclipse-compiler only recompiles
           sources that are more than one day newer than their class files (staleMillis is fixed to
           one day), so changes were silently missing from local builds. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>clean-groovy-classes</id>
            <phase>initialize</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>\${project.build.outputDirectory}</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
         <groupId>org.eclipse.tycho</groupId>
		 <artifactId>tycho-compiler-plugin</artifactId>
		 <version>\${tycho-version}</version>
         <configuration>
           <!-- The JDT embedded in groovy-eclipse-batch of the Groovy 2.5 line (2.5.19-01, the
                version pinned below) accepts source/target levels up to 15 only; anything higher
                is rejected with "source level should be in '1.1'...'1.8','9'...'15'" and the
                compilation fails without a message. The Groovy 3 batch would accept 17 but emits
                indy call sites bound to org.codehaus.groovy.vmplugin.v8.IndyInterface, which the
                Groovy 2.5.23 runtime of the target platform does not have - so the Groovy 2.5
                compiler stays and the Java level of the Groovy-enabled bundles is capped at 15
                instead. The OSGi execution environment (JavaSE-17) is unaffected. -->
           <source>${javaSource.isInteger() && javaSource.toInteger() > 15 ? '15' : javaSource}</source>
           <target>${javaTarget.isInteger() && javaTarget.toInteger() > 15 ? '15' : javaTarget}</target>
                <compilerId>groovy-eclipse-compiler</compilerId>
                <!-- Run the compiler in its own process: groovy-eclipse-batch contains unsigned copies of
                     org.eclipse.core.runtime classes; within the Maven process they clash with the signed
                     Eclipse bundles of the class path ("class org.eclipse.core.runtime.Plugin's
                     signer information does not match signer information of other classes in the same
                     package") and nothing is compiled. -->
                <fork>true</fork>
                <compilerArguments>
                	<% if (artifactId != 'eu.esdihumboldt.cst.functions.groovy') {
						// XXX fails with a compiler error if using indy -> maybe fixed for newer compiler versions?
                		// FIXME make configurable?
                	 %>
                    <indy/><!-- optional; supported by batch 2.4.12-04+ -->
                    <% } %>
                    <!-- <configScript>config.groovy</configScript> -->
                </compilerArguments>
                <verbose>true</verbose>
                <!-- more detailed compiler output: -->
                <!-- <showWarnings>true</showWarnings> -->
                <excludeResources>
            		<excludeResource>**/*.groovy</excludeResource>
            		<!-- Exclude translation files (because they are very incomplete ATM) -->
            		<excludeResource>**/messages_*.properties</excludeResource>
            		<excludeResource>**/bundle_*.properties</excludeResource>
          		</excludeResources>
         </configuration>
         <dependencies>
            <dependency>
	        	<groupId>org.codehaus.groovy</groupId>
	        	<artifactId>groovy-eclipse-compiler</artifactId>
	        	<version>3.7.0</version>
	        </dependency>
	        <dependency>
	        	<groupId>org.codehaus.groovy</groupId>
	        	<artifactId>groovy-eclipse-batch</artifactId>
	        	<version>2.5.19-01</version>
	        	
	        	<!--
	        	<version>2.5.14-02</version> 
	        	<version>2.5.8-02</version> 
	        	-->
	        	<!-- <version>3.0.0-01</version> -->
	        </dependency>
         </dependencies>
      </plugin>
      <% } %>
      <% if (false) /*(isJavaProject)*/ { %>
      <plugin>
			<groupId>org.eclipse.tycho.extras</groupId>
			<artifactId>tycho-document-bundle-plugin</artifactId>
			<version>\${tycho-version}</version>
			<executions>
				<execution>
					<id>javadoc</id>
					<phase>generate-resources</phase>
					<goals>
						<goal>javadoc</goal>
					</goals>
		
					<configuration>
						<basedir>\${doc.output.folder}</basedir>
						<outputDirectory>\${doc.output.folder}/reference/api</outputDirectory>
						<tocFile>\${doc.output.folder}/toc/javadoc.xml</tocFile>
						<!-- javadocOptions>
							<additionalArguments>
								<additionalArgument>-linkoffline
									http://docs.oracle.com/javase/7/docs/api/
									\${basedir}/input/javase-7</additionalArgument>
								<additionalArgument>-linkoffline
									http://www.osgi.org/javadoc/r4v43/ \${basedir}/input/osgi-r4v43</additionalArgument>
							</additionalArguments>
						</javadocOptions -->
					</configuration>
				</execution>
			</executions>
		</plugin>
		<plugin> <!-- if included will conflict with definition below -->
			<groupId>org.eclipse.tycho</groupId>
			<artifactId>tycho-packaging-plugin</artifactId>
			<version>\${tycho-version}</version>
			<configuration>
				<additionalFileSets>
					<fileSet>
						<directory>\${doc.output.folder}</directory>
						<includes>
							<include>**/*</include>
						</includes>
					</fileSet>
				</additionalFileSets>
			</configuration>
		</plugin>
		<% } %>
		<% if(hasProperty('needsTwirl') && needsTwirl) { %>
		<plugin>
			<groupId>com.jakewharton.twirl</groupId>
			<artifactId>twirl-maven-plugin</artifactId>
			<version>1.2.0</version>
			<configuration>
				<templateDirectory>\${project.basedir}/src</templateDirectory>
				<% if (twirlImports) { %>
				<imports>
					<% twirlImports.each { %>
					<import>$it</import>
					<% } %>
				</imports>
				<% } %>
			</configuration>
			<executions>
				<execution>
					<phase>generate-sources</phase>
					<goals>
						<goal>compile</goal>
					</goals>
				</execution>
			</executions>
		</plugin>
		<% } %>
		<plugin>
			<groupId>org.eclipse.tycho</groupId>
			<artifactId>tycho-packaging-plugin</artifactId>
			<version>\${tycho-version}</version>
			<configuration>
				<forceContextQualifier>${contextQualifier}</forceContextQualifier>
			</configuration>
		</plugin>
    </plugins>
  </build>
</project>
